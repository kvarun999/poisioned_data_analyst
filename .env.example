# ─── API & Database ──────────────────────────────────────────────────────────
API_PORT=8080
DATABASE_URL=postgresql://ledger:ledger@ledger:5432/ledger

# ─── Celesto ─────────────────────────────────────────────────────────────────
# Local execution is the default and does not require a cloud API key.
# Set CELESTO_PROVIDER=cloud only if you have a funded Celesto account.
CELESTO_PROVIDER=local
CELESTO_API_KEY=
CELESTO_BACKEND=firecracker

# ─── LLM ─────────────────────────────────────────────────────────────────────
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-with-a-model-name